# ============================================================
# AEGYLAX — ENV CONFIGURATION
# Copy this file to .env(.local) and adjust values.
# All changeable configuration is provided through ENV — never
# hardcode these values inside components.
# ============================================================

VITE_APP_NAME=AEGYLAX
VITE_APP_SUBTITLE=Planetary Defense

# Protocol Status popover. Leave unset: the build stamps 0.MINOR.COMMITS
# from git (major 0 = testnet). Pin only when a build must not consult git.
# VITE_PROTOCOL_VERSION=0.1.40

# "contract" | "emulator"
#
# "contract" is the default and what a real deployment runs: the app reads
# and writes the game contract on the chain `VITE_CHAIN_ID` names, and the
# protocol decides everything. Base Sepolia (84532) is what this file is
# set up for below.
#
# "emulator" settles the game in the browser instead — no chain, no wallet,
# no deployment. It is a development tool and it trusts the tab it runs in,
# so a public build must never ship it. Leaving this value *unset* also
# resolves to the emulator, which is why it is written out here rather than
# left blank: a build's chain mode should be a stated choice, not a default
# nobody looked at. See README — Publish.
VITE_BLOCKCHAIN_MODE=contract

# ---- Authentication & wallets ---------------------------------
# How a player signs in and where their wallet comes from. The app talks
# to this through its own auth layer (frontend/src/auth/), so these settings
# describe the behaviour, not the vendor — swapping the provider is a new
# adapter, not a change here.
#
# "privy" | "local". Left empty it resolves itself: the hosted provider in
# contract mode when an app id is set, and the local emulator identity
# otherwise — so emulator mode keeps working with nothing configured.
# Setting it to "privy" explicitly exercises the real sign-in flow even in
# emulator mode.
VITE_AUTH_PROVIDER=

# Public application id from the provider's dashboard. Not a secret, but
# it must never be hardcoded in source — this is the only place it lives.
VITE_PRIVY_APP_ID=
# Optional per-client id, where the provider issues one.
VITE_PRIVY_CLIENT_ID=

# Which ways in the sign-in screen offers, comma-separated. Every method
# must ALSO be enabled in the provider's dashboard; unknown entries are
# ignored with a warning. Supported: email, sms, wallet, google, apple,
# github, discord, twitter, farcaster, telegram, passkey.
# Defaults to email,google,wallet — the simplest way in, plus a wallet for
# players who already have one.
VITE_AUTH_LOGIN_METHODS=email,google,wallet

# Whether the provider mints a wallet it manages for the player, so that
# signing in with an email is enough to sign transactions and no seed
# phrase is ever shown. Keys stay with the provider — this app never
# receives or stores them.
# "users-without-wallets" (default) | "all-users" | "off"
VITE_AUTH_MANAGED_WALLETS=users-without-wallets

# Sign-in modal appearance. All optional; anything left empty keeps the
# provider's own dashboard setting.
# "light" | "dark" | a hex colour
VITE_AUTH_THEME=dark
VITE_AUTH_ACCENT_COLOR=
VITE_AUTH_LOGO_URL=
# Put "connect a wallet" above the email/social options.
VITE_AUTH_SHOW_WALLET_LOGIN_FIRST=false
VITE_AUTH_TERMS_URL=
VITE_AUTH_PRIVACY_URL=

# Only needed for WalletConnect-based external wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# ---- Network (contract mode) ----------------------------------
# Which network this build talks to. The contract ADDRESS is not set
# here: it comes from the deployment manifest that `npm run
# chain:deploy` generated for this chain id, so a build is pointed at
# a deployment by naming the chain, never by pasting an address.
VITE_CHAIN_ID=84532
# Extra chain ids a player's wallet is also allowed to be on, comma-separated.
# Normally empty: the active chain plus every network with a deployment
# manifest in deployments/ is already allowed, so a new network needs a deploy
# and VITE_CHAIN_ID and nothing here. This is for the cases a manifest cannot
# know about — a fork, or a local node the same player also uses.
VITE_SUPPORTED_CHAIN_IDS=
# A wss:// URL gets a real WebSocket transport (live block/event push via
# eth_subscribe); an http(s):// URL falls back to polling under the hood.
# Falls back to the RPC recorded in the manifest when empty.
#
# Comma-separated for more than one, and on a public network you want more
# than one: the app reads on every block, a shared endpoint answers that
# with 403 and no CORS header, and from inside the browser a rate limit is
# indistinguishable from an empty protocol — the operation does not load and
# the controls never come alive. The client puts these behind a fallback
# transport and ranks them by how they are actually behaving, and the
# manifest's own endpoint is always appended as the last resort. The same
# HTTPS list is handed to the confidential layer's own SDK; without it Inco
# independently hits PublicNode and AttestedReveal 500s after a 403.
VITE_RPC_URL=
# Overrides the explorer recorded in the manifest. Every explorer link in
# the UI is built from this one value (utils/explorer.ts).
VITE_EXPLORER_URL=
# Escape hatches, both normally empty: they override the manifest for a
# local node or a one-off contract instance.
VITE_CONTRACT_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# The contract's epoch grid origin (`genesisBlock()`). Distinct from the
# proxy deploy block above; using that one for countdowns puts the header
# on a different grid than the chain. Empty = the value in the manifest.
VITE_GENESIS_BLOCK=
# Used only to turn block numbers into human countdowns. Base is ~2s.
VITE_BLOCK_TIME_MS=2000

# ---- Confidentiality ------------------------------------------------
# Where the "Privacy layer" row in the Protocol Status panel links to:
# the site of whoever provides confidentiality for this deployment. The
# layer's *name* and its executor contract come from the deployment
# manifest, so this is only the human destination — point it somewhere else
# and the panel follows, with nothing to edit in a component. Left empty the
# row is plain text. `VITE_PRIVACY_PROTOCOL_URL` is still read as a fallback.
# Which layer that is, and which deployment of it, comes from the manifest
# (`confidentialEngine.kind` / `.release`) — so a build pointed at a Fhenix
# deployment names Fhenix here and one pointed at Inco names Inco, with
# nothing to edit in a component.
VITE_PRIVACY_LAYER_URL=https://www.fhenix.io/
# Which provider theme the app paints in.
#
# Empty is the normal case and the intended one: the theme follows the
# confidential provider this build actually talks to, read off the
# deployment manifest's `confidentialEngine.kind`. A Fhenix deployment wears
# the Fhenix theme with nothing configured, and there is no theme selector in
# the UI — a player never picks a provider, so a player never picks a theme.
#
# Set it only to preview another provider's look against an existing
# deployment. It changes paint and provider labels; it never changes which
# confidential network the client encrypts against. Known values: fhenix,
# mock (and "inco", whose provider is switched off but whose palette still
# renders). An unknown one is ignored and the deployment's own theme stands.
VITE_PROVIDER_THEME=
# The confidential network's session-verifier contract on this chain.
#
# **Inco only, and Inco is switched off in this build** — so this line is
# inert everywhere today. Fhenix CoFHE uses a permit for the same job and
# needs no address configured. Kept because the field is read from the
# manifest rather than from here, and an old deployment may still carry one.
#
# What it changes is how often a player is asked to sign. A Recon Probe is
# one transaction, but reading what it found is a second, separate
# authorisation — and Inco's per-read request is bound to the exact handle,
# so it can never be reused: two prompts per probe, and more than two
# whenever the covalidator is still catching up with the chain and the read
# has to be retried.
#
# Inco's published verifiers for Base Sepolia and Base are used when this
# is empty, so a stock build already sends a probe as one transaction.
# Override only when talking to a different confidential network.
VITE_CONFIDENTIAL_SESSION_VERIFIER=

# ---- Protocol limits ------------------------------------------
# Hard boundaries of the game itself. A Defense Operation creator picks
# values INSIDE these ranges and can never change the ranges — they are
# re-validated at creation time, so a hand-edited payload cannot bypass
# the form.
#
# In CONTRACT MODE every value below is IGNORED. The authority is the
# deployed contract: `initialize()` wrote these limits into its storage,
# `npm run chain:sync` copied them into the deployment manifest, and
# `config/env.ts` reads them back from there — so the form can only ever
# offer what the chain will accept. Configure them for a real deployment
# in contracts/.env instead.
#
# What is below therefore applies to EMULATOR MODE, and to a contract
# build pointed at a chain with no manifest yet.
# Live Sepolia is 25. The Solidity field is uint16 (65535); ProtocolRules
# only checks max >= min. The number that binds is gas: one reveal must
# verify every encrypted Defense Point in a single Base transaction.
VITE_MIN_PLAYERS=2
VITE_MAX_PLAYERS=25
# ETH
VITE_MIN_ENTRY_FEE=0.0005
VITE_MAX_ENTRY_FEE=0.1
# ETH the creator must actually fund the operation with at launch.
# 0 allows an operation whose pool comes purely from entries.
VITE_MIN_START_PRIZE_POOL=0.001
# Application window (how long a creator may keep joining open).
# 0 minutes = no minimum beyond "must be in the future".
VITE_MIN_REGISTRATION_DURATION_MINUTES=0
VITE_MAX_REGISTRATION_DURATION_DAYS=30
VITE_MAX_CREATOR_FEE_PERCENT=15
VITE_MAX_RECON_PROBES=6

# ---- Protocol / economics -----------------------------------
# All values below are in the game currency unless otherwise noted.
# Protocol join fee is charged once per seat, including the creator's
# (paid at launch together with the start prize pool).
VITE_PROTOCOL_JOIN_FEE=0.0005
VITE_CREATOR_FEE_PERCENT=5
VITE_DEFAULT_ENTRY_PRICE=0.0005

# What amounts are labelled with, and which coin they actually are.
#
# Ticker is the short label next to every figure (ETH, USDC). Name is the
# long form a tooltip uses. Token is empty for the chain's native coin and
# an ERC-20 address when the prize is a token — switching the game to USDC
# is these three, plus a contract that accepts that token.
VITE_GAME_CURRENCY=ETH
VITE_GAME_CURRENCY_NAME=Ether
VITE_GAME_CURRENCY_TOKEN=

# ---- Recon Probes ----------------------------------------------
# Protocol-owned: one price and one allowance for the epoch's threat.
VITE_RECON_PROBE_FREE_COUNT=3
VITE_RECON_PROBE_PRICE=0.0002

# ---- Emulator ----------------------------------------------------
VITE_EMULATOR_INITIAL_BLOCK=1
VITE_EMULATOR_BLOCK_TIME_MS=2000

# ---- Attack ------------------------------------------------------
# An operation gets exactly one attack. It launches at an epoch boundary
# and impacts at the next one, so the epoch length below is also the
# flight duration.
#
# Speed is NOT configured: an attack starts on the playfield's outer edge
# and ends on an arbitrary point on Earth, so how far it travels is
# different every time, and its speed is derived as distance / flight
# duration. Short trajectories therefore move slowly and long ones
# quickly, and every attack lands exactly on the epoch boundary.
VITE_ATTACK_EPOCH_BLOCKS=150

# Side of one sector in kilometres — the playfield's only declared scale,
# and what the whole world's size follows from. With the 10x5 grid below,
# 1000 makes a 10,000 x 5,000 km board.
VITE_SECTOR_SPAN_KM=1000

# How close a Defense Point has to be for the threat to enter its
# interception radius, measured in sectors so it means the same thing
# whatever the grid resolution. Lower is harder. Protocol-owned: a player
# cannot change it, the same value is used by the frontend, the private
# computation and contract verification, and lobby creation is rejected if
# a config tries to override it.
VITE_DEFENSE_INTERCEPTION_RADIUS=0.14

# How fast an interceptor climbs from Earth's surface to its Defense Point,
# in km per block. Arrival (submit + climb) is when the threat is sampled.
VITE_DEFENSE_SPEED_KM_PER_BLOCK=250

# How often the Global Defense Pool is played for, in epochs (ТЗ §18).
#
# Every COMPLETED round the threat won sends its unwon pool here rather than
# home to the creator. Once every N epochs the protocol opens a free-to-enter
# operation of its own ("Global Defense") with the whole accumulated pool as
# the bounty. If nobody intercepts that draw either, the pool returns by the
# same rule and waits for the next interval — there is no special "draw
# failed" branch.
#
# 1000 is the live cadence. Drop this to 2 or 3 to exercise the rollover in
# the emulator without waiting a thousand epochs. 0 disables the draw.
# On a deployed chain the contract's own `globalDefenseEpochInterval` is the
# authority (set at deploy via GAME_GLOBAL_DEFENSE_EPOCH_INTERVAL, or later
# with setGlobalDefenseInterval); this ENV value is what the emulator uses.
VITE_GLOBAL_DEFENSE_EPOCH_INTERVAL=1000

# How long the Global Defense lobby accepts joins, in hours.
#
# Prefer a calendar day so people have time to walk in. The draw still plays
# at the next interval epoch (1000, 2000, …); this only decides how close to
# that epoch the lobby may be opened. If N epochs is shorter than this
# window, the protocol uses half the interval instead (~500 epochs when N is
# 1000) so the other half can accumulate prizes toward the next draw.
VITE_GLOBAL_DEFENSE_JOIN_WINDOW_HOURS=24

# ---- Map / sectors -------------------------------------------------
# The playfield grid drawn over the operation scene: this many columns
# (lettered A, B, C...) by this many rows (numbered 1, 2, 3...), so 10x5
# is the shipped 50 sectors A1..J5. Raise/lower freely — nothing in the
# UI hardcodes a sector count — but keep columns <= 26 so every column
# still has a letter, and remember that a finer grid narrows down where
# the hidden attack is without adding any play.
VITE_MAP_GRID_COLUMNS=10
VITE_MAP_GRID_ROWS=5

# Draw the A-J column letters and 1-5 row numbers along the grid's edges.
# Off by default: a sector is picked by clicking it and the cell under the
# pointer already says what it is called, so the permanent ring of labels
# was spending attention on a coordinate system nobody has to name. Set to
# true for builds that want to talk about sectors by name.
VITE_MAP_SHOW_GRID_LABELS=false

# ---- Apocalypse Timer (Day X / Event Horizon) -----------------------
# The global countdown shown over Earth (spec §15-19): a base date the
# protocol moves away from as attacks resolve.
#
#   DayX = base - (MISS x DAYS_PER_MISS) + (INTERCEPT x DAYS_PER_INTERCEPT)
#
# The two rates are deliberately unequal, and the ratio between them is the
# whole economic statement of the timer. A miss pulls Day X closer by a
# little; an interception pushes it back by ten times as much, so one
# successful defense buys back ten failures. Under the single symmetric
# constant this replaces only the *net* moved the date, which meant a
# protocol running at an even hit rate showed a horizon that never moved.
VITE_APOCALYPSE_BASE_DATE=2030-01-01T00:00:00Z
VITE_APOCALYPSE_DAYS_PER_MISS=0.01
VITE_APOCALYPSE_DAYS_PER_INTERCEPT=0.1

# ---------------------------------------------------------------------------
# Backend (api/) — deployed separately, see render.yaml
# ---------------------------------------------------------------------------
# Where the frontend finds the faucet. A public URL, so VITE_ is correct
# here: nothing secret is ever reachable from this config. Empty means same
# origin, which is what a dev server with a proxy gives you.
VITE_API_URL=https://aegylax-private.onrender.com

# Everything the backend itself needs lives in ITS environment (Render →
# Environment), never here and never with a VITE_ prefix. Vite inlines every
# VITE_* variable into the JavaScript bundle in plain text, so a private key
# placed there is published to every visitor. The backend reads:
#
#   CHAIN_ID, RPC_URL          which chain it serves
#   CORS_ORIGINS               comma-separated origins allowed to call it
#   CORS_VERCEL_PROJECT        optional: allow this project's previews
#   FAUCET_EVM_PRIVATE_KEY     the wallet the faucet pays from
#   FAUCET_DRIP_ETH            what one drip pays out, default 0.02
#   EXPLORER_API_KEY           Etherscan-v2 key, for the cooldown lookup
#   FAUCET_COOLDOWN_HOURS      default 24
#   KEEPER_PRIVATE_KEY         the wallet the keeper sends from
#   KEEPER_SWEEP_SECONDS       default 30
#   KEEPER_REVEAL              whether it also reveals finished rounds
#   INDEXER_ENABLED            player records; "false" turns the route off
#   INDEXER_POLL_SECONDS       default 20
#   INDEXER_LOG_WINDOW         blocks per eth_getLogs, default 9000
#   INDEXER_CONFIRMATIONS      how far behind the head to fold, default 5
#   INDEXER_FROM_BLOCK         override the deployment block it starts at
#
# The indexer holds no key and sends nothing — it reads the protocol's own
# events and answers GET /api/players/:address with what one wallet did.
#
# Use three separate wallets: the contract owner, the faucet and the keeper.
# The backend signs unattended, so an owner key there turns a server
# compromise into a protocol takeover rather than a drained faucet.
