node_modules
dist
dist-ssr
*.local

.env
.env.*.local
.env.local
# Any copy of a secrets file, whatever it is called. `.env` alone did not
# cover `.env.backup-*`, and one `git add -A` away from that is a deployer
# private key in a commit.
.env.*
!.env.example
contracts/.env.*
!contracts/.env.example

.vscode/*
!.vscode/extensions.json
.idea

# Editor / agent local state — never a public artifact.
.claude
.vercel
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pem

coverage

# Scratch an agent or a debugging session leaves behind: benchmark
# scripts, screenshots, throwaway browser profiles. Three of these had
# already been committed — including a Chromium profile's GPU cache — which
# is how this section came to exist.
.bench
.tmp-*
scratch/
# Screenshots dropped in the root by a debugging session. Three of these
# reached main before this line existed.
/*.png

# Local / CI junk — never a Vercel or git artifact.
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.turbo
.cache
playwright-report
test-results
blob-report
*.tgz
lcov.info

# Contracts
contracts/out
contracts/cache
contracts/broadcast
contracts/node_modules
contracts/.env

# Generated by `npm run chain:deploy` for local networks; real network
# manifests are committed on purpose — they are the record of what is
# deployed, and the frontend reads them.
deployments/31337.json
deployments/31337.storage-layout.json

# Compiled backend — built on the host from api/ at deploy time.
dist-server/
dist-emu
frontend/dist
