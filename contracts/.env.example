# ==============================================================
# AEGYLAX — CHAIN DEPLOYMENT CONFIGURATION
# Copy to contracts/.env and fill in. Never commit the real file.
#
# Everything the deployment pipeline needs lives here, and nothing
# it needs lives in source. Switching networks is editing this
# file and re-running `npm run chain:deploy` — no code change,
# no address pasted into the frontend (ТЗ §8).
# ==============================================================

# ---- Network -------------------------------------------------
NETWORK_NAME=base-sepolia
CHAIN_ID=84532
# Accepted aliases: BASE_SEPOLIA_RPC, BASE_RPC, ETH_RPC_URL.
RPC_URL=https://sepolia.base.org
# Written into the manifest and used by the UI for clickable links.
EXPLORER_URL=https://sepolia.basescan.org
# Optional: the RPC the *frontend* should use, if it differs from the
# deployer's (a public endpoint rather than a keyed one, for instance).
PUBLIC_RPC_URL=

# ---- Keys ----------------------------------------------------
# The account that deploys and, unless OWNER_ADDRESS says otherwise,
# owns the protocol afterwards.
#
# Accepted aliases, so a key pasted under its conventional Foundry /
# Hardhat name still works: PRIVATE_KEY, TEST_CREATOR_PK.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

# Basescan/Etherscan key for `npm run chain:verify` (also runs at the end of
# deploy and upgrade). Alias: BASESCAN_API_KEY.
ETHERSCAN_API_KEY=
# Optional: override the explorer API. Leave unset — an empty value makes
# forge treat the verifier URL as relative and fail.
# VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=84532
# Set true to skip explorer verification after deploy/upgrade.
SKIP_VERIFY=false

# ---- Confidential layer --------------------------------------
# Which confidential network holds this deployment's secrets. The game
# contract does not know: it talks to `IConfidentialEngine`, and this
# picks the adapter deployed behind it. Switching is this line plus a
# redeploy of the engine — no source change anywhere.
#
# "fhenix" — Fhenix CoFHE. The default. Attack geometry is drawn inside
#            the coprocessor, probe hints are arithmetic on ciphertext,
#            and a Defense Point is sealed in the browser.
# "inco"   — Inco Lightning. SWITCHED OFF. The adapter, the gateway and
#            their tests are all still here, but the deployer refuses this
#            value: AEGYLAX runs on Fhenix CoFHE. Re-enable by deleting the
#            `disabled` field from the inco row in
#            tools/chain/confidential.mjs.
# "mock"   — plain storage. Local development only; every secret is
#            publicly readable. Requires ALLOW_MOCK_ENGINE=true.
# 0x...    — an already-deployed engine to reuse. Which provider it is
#            gets read off the chain (`engineKind()`), not guessed.
CONFIDENTIAL_ENGINE=fhenix
ALLOW_MOCK_ENGINE=false

# Which deployment of that network to use. Every provider spells this
# differently, so each has its own variable below and
# CONFIDENTIAL_RELEASE overrides whichever one applies.
# CONFIDENTIAL_RELEASE=

# --- Fhenix CoFHE ---
# MAINNET | TESTNET | LOCAL | MOCK. Selects the coprocessor, the ZK
# verifier and the threshold network as one set — the client SDK
# resolves all three from this name, and a value that disagrees with the
# chain the engine was deployed to produces handles nothing can open.
#
# Unlike an Inco pepper this is *not* a compile-time choice: CoFHE links
# one TaskManager address on every chain it supports, so the deployer
# checks that the TaskManager is actually live on CHAIN_ID and refuses
# otherwise, rather than letting the first attack revert for no visible
# reason.
COFHE_ENVIRONMENT=TESTNET

# --- Inco Lightning ---
# Which Inco release to compile against and talk to. The engine links
# that release's executor at compile time and the client SDK resolves
# its covalidator quorum from the same name, so they are one choice and
# the pipeline refuses a deployment where they disagree.
#
# Base Sepolia has both "testnet" and "devnet" lines live. As of this
# writing the testnet covalidator ingress serves an invalid certificate
# and answers 404, so "devnet" is what actually resolves there.
# Inert while "inco" is switched off (see CONFIDENTIAL_ENGINE above).
INCO_PEPPER=devnet

# Inco charges a fee per confidential operation out of the engine's own
# balance, so a deployment funds it. An unfunded engine is a protocol
# that cannot start an attack. Ignored for providers that bill
# confidential work as gas on the calling transaction (CoFHE does), and
# the deployer skips the transfer rather than stranding ETH.
ENGINE_FUNDING_ETH=0.004

# ---- E2E wallets ---------------------------------------------
# `npm run chain:e2e` plays a whole operation against the deployed
# contract with three separate keys: a creator who funds and starts it,
# and two defenders who join, probe and defend from their own wallets.
# Testnet keys only.
TEST_CREATOR_PK=
TEST_RECIPIENT1_PK=
TEST_RECIPIENT2_PK=
# How long applications stay open during an E2E run, in blocks — the unit
# the protocol enforces and derives the attack's epoch from. Measured from
# the block the operation is created in, so it has to be comfortably longer
# than the run takes to get two defenders joined (~2 blocks per transaction
# plus RPC catch-up). 60 blocks is about two minutes on Base.
E2E_REGISTRATION_BLOCKS=60
# Print the full stack of whatever an E2E step failed on, rather than the
# one-line summary. Off unless you are debugging the run itself.
E2E_VERBOSE=false

# ---- Protocol parameters (on-chain, immutable per operation) --
# These are written into contract storage by initialize() and copied
# onto every lobby at creation, so the frontend reads them back from
# the chain rather than keeping its own copy.

# The playfield: columns x rows sectors, and how many km a sector is
# across. The board's size, and therefore every distance in the game,
# follows from these three.
GAME_GRID_COLUMNS=10
GAME_GRID_ROWS=5
GAME_SECTOR_SPAN_KM=1000

# DEFENSE_INTERCEPTION_RADIUS, in thousandths of a sector. 140 = 0.14.
GAME_INTERCEPT_RADIUS_MILLI_SECTORS=140

# Blocks per epoch. An attack launches on one boundary and impacts on
# the next, so this is also T_attack — the full flight time. Speed is
# never configured: it is distance / T_attack, per attack.
# On a testnet this doubles as the length of a playable test round: two
# defenders have to probe, read their answers through the confidential
# network and commit a Defense Point inside it. 120 blocks is ~4 minutes
# on Base.
GAME_EPOCH_BLOCKS=150

# How fast an interceptor climbs from the surface to its Defense Point,
# in km per block. This is what makes "who arrived first" a different
# question from "who clicked first".
GAME_DEFENSE_SPEED_KM_PER_BLOCK=250

# Angular jitter on a probe's noisy θ and δ, in microradians.
# 174533 ~= 10 degrees — wider than one intercept radius, tight enough
# that a snapshot still reads as near the path. Tune with setParams.
GAME_PROBE_CONE_MICRO_RAD=174533

# How long after impact an unrevealed attack may sit before anyone can
# expire it and refund every participant.
GAME_REVEAL_GRACE_BLOCKS=5000

# Boundaries a lobby creator picks inside and can never widen.
# GAME_MAX_PLAYERS is 25 on live Sepolia: one revealAndResolve verifies
# every encrypted Defense Point in a single Base transaction. The Solidity
# field is uint16 (65535) and ProtocolRules only checks max >= min. Raising
# this without a chunked reveal is a gas experiment, not a type one.
GAME_MIN_PLAYERS=2
GAME_MAX_PLAYERS=25
GAME_MAX_PROBES_PER_PLAYER=6
GAME_FREE_PROBES=3
GAME_MAX_CREATOR_FEE_BPS=1500
GAME_MIN_REGISTRATION_SECONDS=0
GAME_MAX_REGISTRATION_SECONDS=2592000
GAME_MIN_ENTRY_FEE_ETH=0.0005
GAME_MAX_ENTRY_FEE_ETH=0.1
GAME_MIN_START_PRIZE_POOL_ETH=0.001
GAME_PROBE_PRICE_ETH=0.0002
GAME_PROTOCOL_JOIN_FEE_ETH=0.0005

# How often the Global Defense Pool is played for, in epochs.
#
# The pool is where a COMPLETED round the threat won sends its money: nobody
# in that operation earned it, and it does not go home to the creator. Every
# GAME_GLOBAL_DEFENSE_EPOCH_INTERVAL epochs the protocol opens an operation of
# its own with the whole accumulated pool as the bounty, free to enter, and
# whoever intercepts that epoch's threat takes all of it. A draw nobody wins
# simply returns its pool to the pool and waits for the next interval — the
# same rule that filled it, so there is no special case for it failing.
#
# 0 disables the draw and leaves the pool accumulating.
# 1000 is the live cadence. Drop this to 2 or 3 to exercise the rollover
# without waiting a thousand epochs. 0 disables the draw. The owner can
# also call setGlobalDefenseInterval after deploy without a new contract.
GAME_GLOBAL_DEFENSE_EPOCH_INTERVAL=1000

# Block the shared epoch grid is measured from — and therefore what the
# status bar counts attacks from: the protocol has flown one attack per epoch
# since this block, whether or not anybody defended them.
#
# 0 means "this deployment's own block". Which value is right depends on what
# the redeploy *is*, and the two cases pull opposite ways:
#
#   - **Same protocol, new implementation.** Pin this to the first
#     deployment's block and keep it there. Leaving it at 0 restarts the
#     epoch counter and throws away the protocol's age.
#
#   - **A new protocol instance** — a different confidential provider, a
#     deliberate fresh start. Use 0. Inheriting the old grid looks
#     continuous but is not: `interceptedAttacks` is a real stored counter
#     and starts at zero on a new contract, while `totalAttacks` and
#     `missedAttacks` are derived from elapsed epochs and do not. The result
#     is a day-old contract reporting thousands of misses and no
#     interceptions — a worse record than the deployment it replaced, for
#     rounds it never saw.
#
# There is no third option after the fact: `genesisBlock` is written once by
# `initialize()` and has no setter, because moving the epoch grid would move
# the schedule of every operation already in flight.
GENESIS_BLOCK=0

# ---- Pipeline switches ---------------------------------------
# Skip `forge test` during deploy. Do not.
SKIP_TESTS=false
# Whether `npm run chain:upgrade` also redeploys the lens facet. The lens is
# pure reads, so leaving this on keeps it in step with the implementation it
# reads from; turn it off to upgrade the game contract alone.
UPGRADE_LENS=true

# ---------------------------------------------------------------------------
# Keeper (npm run chain:keeper)
# ---------------------------------------------------------------------------
# Closing applications, cancelling an under-filled operation and unlocking a
# landed round are permissionless but necessary: until somebody sends them an
# operation has no result and no claimable reward. In the app they are sent
# from whichever player has the page open, which is not enough for a public
# demo — people close the tab. This runs the same three calls from somewhere
# that does not.
#
#   node tools/chain/keeper.mjs --watch
#
# In the hosted demo this runs inside the backend instead (api/keeper/),
# which also reveals finished rounds. The CLI stays for local runs and for
# poking a stuck operation by hand.

# Falls back to DEPLOYER_PRIVATE_KEY. Prefer a separate key holding gas money
# and nothing else: this is the one process that runs unattended.
KEEPER_PRIVATE_KEY=

# Seconds between sweeps in --watch mode.
KEEPER_SWEEP_SECONDS=30
